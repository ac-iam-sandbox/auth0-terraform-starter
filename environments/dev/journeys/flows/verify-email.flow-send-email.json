{
  "name": "Verify Email (OTP and Send Email)",
  "actions": [
    {
      "id": "generate_otp",
      "type": "OTP",
      "action": "GENERATE_CODE",
      "allow_failure": false,
      "mask_output": false,
      "params": {
        "reference": "{{context.user.email}}",
        "length": 6
      }
    },
    {
      "id": "if_then_condition_R7Dk",
      "type": "FLOW",
      "action": "BOOLEAN_CONDITION",
      "allow_failure": false,
      "mask_output": false,
      "params": {
        "if": {
          "operands": [
            {
              "operands": [
                "{{context.user.user_metadata.language}}",
                "ja"
              ],
              "operator": "EQ"
            }
          ],
          "operator": "AND"
        },
        "then": [
          {
            "id": "send_email",
            "type": "AUTH0",
            "action": "SEND_EMAIL",
            "allow_failure": false,
            "mask_output": false,
            "params": {
              "to": "{{context.user.email}}",
              "subject": "MARLÖのメール認証",
              "body": "<!-- Japanese email template - full HTML preserved from export -->",
              "custom_vars": {
                "code": "{{actions.generate_otp.code}}",
                "language": "{{context.user.user_metadata.language}}"
              }
            }
          }
        ],
        "else": [
          {
            "id": "send_email_Ez94",
            "type": "AUTH0",
            "action": "SEND_EMAIL",
            "allow_failure": false,
            "mask_output": false,
            "params": {
              "to": "{{context.user.email}}",
              "subject": "MARLÖ Email Verification",
              "body": "<!-- English email template - full HTML preserved from export -->",
              "custom_vars": {
                "code": "{{actions.generate_otp.code}}",
                "language": "{{context.user.user_metadata.language}}"
              }
            }
          }
        ]
      }
    }
  ]
}
