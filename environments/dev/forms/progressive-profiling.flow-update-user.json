{
  "name": "Progressive Profiling (Update User)",
  "actions": [
    {
      "id": "if_then_condition",
      "alias": "Check if email verification was done",
      "type": "FLOW",
      "action": "BOOLEAN_CONDITION",
      "allow_failure": false,
      "mask_output": false,
      "params": {
        "if": {
          "operands": [
            { "operands": ["{{ fields.link_email.needs_verification }}", true], "operator": "EQ" }
          ],
          "operator": "AND"
        },
        "then": [
          {
            "id": "update_user_on_true",
            "type": "AUTH0",
            "action": "UPDATE_USER",
            "allow_failure": false,
            "mask_output": false,
            "params": {
              "connection_id": "#CONN-1#",
              "user_id": "{{context.user.user_id}}",
              "changes": {
                "given_name": "{{fields.first_name}}",
                "family_name": "{{fields.last_name}}",
                "app_metadata": {
                  "signup_source": "marlo_patient_portal",
                  "registration_completed": true
                },
                "user_metadata": {
                  "email": "{{ fields.link_email.email }}",
                  "consents": {
                    "marlo_patient_portal": {
                      "marketing": { "agreed": "{{ functions.toBoolean( fields.marketing_communication ) }}", "version": "1.0", "timestamp": "{{ functions.toTimestamp() }}" },
                      "terms_and_privacy": { "agreed": "{{ functions.toBoolean( fields.terms_and_privacy ) }}", "version": "1.0", "timestamp": "{{ functions.toTimestamp() }}" },
                      "health_data_processing": { "agreed": "{{ functions.toBoolean( fields.health_data_processing ) }}", "version": "1.0", "timestamp": "{{ functions.toTimestamp() }}" }
                    }
                  },
                  "given_name_kana": "{{fields.first_name_kana}}",
                  "family_name_kana": "{{fields.last_name_kana}}"
                }
              }
            }
          }
        ],
        "else": [
          {
            "id": "update_user_on_false",
            "type": "AUTH0",
            "action": "UPDATE_USER",
            "allow_failure": false,
            "mask_output": false,
            "params": {
              "connection_id": "#CONN-1#",
              "user_id": "{{context.user.user_id}}",
              "changes": {
                "given_name": "{{fields.first_name}}",
                "family_name": "{{fields.last_name}}",
                "app_metadata": {
                  "signup_source": "marlo_patient_portal",
                  "registration_completed": true
                },
                "user_metadata": {
                  "consents": {
                    "marlo_patient_portal": {
                      "marketing": { "agreed": "{{ functions.toBoolean( fields.marketing_communication ) }}", "version": "1.0", "timestamp": "{{ functions.toTimestamp() }}" },
                      "terms_and_privacy": { "agreed": "{{ functions.toBoolean( fields.terms_and_privacy ) }}", "version": "1.0", "timestamp": "{{ functions.toTimestamp() }}" },
                      "health_data_processing": { "agreed": "{{ functions.toBoolean( fields.health_data_processing ) }}", "version": "1.0", "timestamp": "{{ functions.toTimestamp() }}" }
                    }
                  },
                  "given_name_kana": "{{fields.first_name_kana}}",
                  "family_name_kana": "{{fields.last_name_kana}}"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
