{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auth0 Action Modules Configuration",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["name", "code_file"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "code_file": { "type": "string", "pattern": "\\.js$" },
      "publish": { "type": "boolean", "default": true },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "default": []
      },
      "secrets": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "value"],
          "properties": {
            "name": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        "default": []
      }
    }
  }
}
