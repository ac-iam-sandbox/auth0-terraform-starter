{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auth0 Flows Configuration",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "name",
      "file"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "file": {
        "type": "string",
        "pattern": "\\.json$"
      },
      "token_replacements": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "env_replacements": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
