# Bucket name comes from TF_STATE_BUCKET in variable group na-prod-axon-cic.
# If using variable group value, override at init:
#   terraform init -backend-config="bucket=$(TF_STATE_BUCKET)" -backend-config=backends/prod.s3.tfbackend
key          = "auth0/prod/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
