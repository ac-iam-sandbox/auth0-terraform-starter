# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config (often contains credentials or mirrors)
.terraformrc
terraform.rc

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Keep env/backend examples only if you create example files
# !*.example.tfvars
# !*.example.tfbackend

# Local plan / debug / temp files
*.plan
*.out
*.bak
*.backup
*.tmp
*.temp

# Sensitive local environment files
.env
.env.*
!.env.example
!.env.sample

# Node / JS tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build / bundle outputs
dist/
build/
coverage/
*.tsbuildinfo

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS / misc
.cache/
.tmp/
temp/