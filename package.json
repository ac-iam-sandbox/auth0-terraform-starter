{
  "name": "auth0-terraform-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "promote": "node scripts/promote.mjs",
    "verify:manifests": "node scripts/verify-manifests.mjs",
    "verify:schemas": "node scripts/validate-schemas.mjs",
    "verify": "npm run verify:schemas && npm run verify:manifests",
    "build": "cd actions && npm run build",
    "test": "cd actions && npm test",
    "lint": "cd actions && npm run lint",
    "fmt:tf": "terraform fmt -recursive modules/",
    "fmt:check": "terraform fmt -check -recursive -diff modules/"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "modules/**/*.tf": [
      "terraform fmt -write=true"
    ],
    "actions/src/**/*.ts": [
      "bash -c 'cd actions && npx eslint --fix'"
    ],
    "environments/**/*.json": [
      "node scripts/validate-schemas.mjs"
    ]
  }
}
